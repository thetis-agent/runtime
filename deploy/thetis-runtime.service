# Thetis runtime: the kernel daemon, its control socket, the door on the configured port, and every installed
# service (the login target in the system userspace, one web gateway per person). Delegate=yes hands the unit's
# cgroup to the kernel so each fence gets its memory, pid and cpu limits.
# Install:  sudo cp deploy/thetis-runtime.service /etc/systemd/system/ && sudo systemctl daemon-reload
#           sudo systemctl enable --now thetis-runtime.service
# The CLI in this checkout talks to the running daemon through .thetis/thetis.sock.
[Unit]
Description=Thetis runtime (kernel daemon and services)
After=network-online.target
Wants=network-online.target
# The brake on a genuine crash loop: five starts inside five minutes and systemd gives up rather than spinning
# on code that cannot boot. Both belong in [Unit] — under [Service] older systemd ignores them without a word,
# which would leave a guard that looks present and does nothing. `systemctl reset-failed` clears the block.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=thetis
Group=thetis
WorkingDirectory=/srv/thetis/runtime
ExecStart=/home/thetis/.local/bin/node /srv/thetis/runtime/bin/thetis.js serve
# `always`, not `on-failure`, because a restart Thetis asks for is a *clean* exit: the latch resolves the same
# promise Ctrl+C does, the process exits 0, and only `always` brings it back. With `on-failure` that exit is
# taken as success and the installation stays down. This does not defeat `systemctl stop`: a stop is systemd's
# own doing rather than the unit ending, and a stopped unit stays stopped.
# The daemon reads this back at startup (systemctl show -p Restart) and refuses to arm a restart unless it says
# always, so changing it here without `systemctl daemon-reload` disables the feature rather than breaking it.
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=30
Delegate=yes
# /run/thetis, made at start and removed at stop, owned by User=. The daemon puts the control socket's
# token there: somewhere no fence can read, because bubblewrap gives each fence a fresh /run. Without this
# line the daemon requires no token and the socket admits anyone who can open it, which is what it did
# before -- the feature arms itself when the directory is guaranteed. /run/user/<uid> is deliberately not
# used as a fallback: logind removes it with the last login session unless lingering is on, and a token
# file vanishing under a running daemon would lock the command line out of its own restart.
RuntimeDirectory=thetis
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
