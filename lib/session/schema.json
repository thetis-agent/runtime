{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thetis://internal/session-events/1",
  "$defs": {
    "event": {
      "allOf": [
        {
          "$ref": "thetis://contract/turn-events/1#/$defs/envelope"
        },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "token"
                },
                "payload": {
                  "$ref": "thetis://contract/turn-events/1#/$defs/token"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "output"
                },
                "payload": {
                  "$ref": "thetis://contract/turn-events/1#/$defs/output"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "end"
                },
                "payload": {
                  "$ref": "thetis://contract/turn-events/1#/$defs/end"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "input"
                },
                "payload": {
                  "$ref": "thetis://contract/turn-events/1#/$defs/input"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "call"
                },
                "payload": {
                  "oneOf": [
                    {
                      "$ref": "thetis://contract/turn-events/1#/$defs/callRequest"
                    },
                    {
                      "$ref": "thetis://contract/turn-events/1#/$defs/callAnswer"
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "notice"
                },
                "payload": {
                  "$ref": "thetis://contract/turn-events/1#/$defs/notice"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "model.event"
                },
                "payload": {
                  "$ref": "thetis://contract/turn-events/1#/$defs/modelEvent"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "retrieve"
                },
                "payload": {
                  "$ref": "thetis://contract/skills/1#/$defs/retrieveAnswer"
                }
              }
            }
          ]
        }
      ]
    },
    "batch": {
      "type": "object",
      "required": [
        "type",
        "conversation",
        "cursor",
        "events"
      ],
      "properties": {
        "type": {
          "const": "session.events"
        },
        "conversation": {
          "type": "string",
          "maxLength": 256
        },
        "cursor": {
          "type": "integer",
          "minimum": 1
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "history": {
      "type": "object",
      "required": [
        "messages",
        "truncated"
      ],
      "properties": {
        "messages": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "thetis://contract/turn-events/1#/$defs/message"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "subscribed": {
      "type": "object",
      "required": [
        "conversation",
        "cursor",
        "oldest"
      ],
      "properties": {
        "conversation": {
          "type": "string",
          "maxLength": 256
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "history": {
          "$ref": "#/$defs/history"
        },
        "oldest": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$ref": "#/$defs/batch"
}
