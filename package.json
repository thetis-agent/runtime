{
  "name": "thetis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "workspaces": [
    "kernel",
    "contracts/*",
    "lib/*",
    "test"
  ],
  "scripts": {
    "check": "node --import ./lib/artifacts/source.mjs scripts/check.ts",
    "build": "node --import ./lib/artifacts/source.mjs scripts/build.ts",
    "test": "node --import ./lib/artifacts/source.mjs scripts/test.ts",
    "bench": "node --import ./lib/artifacts/source.mjs scripts/bench.ts",
    "size": "node --import ./lib/artifacts/source.mjs scripts/size.ts",
    "release": "node --import ./lib/artifacts/source.mjs scripts/release.ts",
    "live": "node --import ./lib/artifacts/source.mjs scripts/live.ts",
    "generate": "node --import ./lib/artifacts/source.mjs lib/schema/generate.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "semver": "7.7.2",
    "ws": "8.21.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/semver": "7.7.1",
    "@types/ws": "8.18.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
