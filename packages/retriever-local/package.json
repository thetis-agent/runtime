{
  "name": "retriever-local",
  "version": "1.0.0",
  "type": "module",
  "exports": "./index.ts",
  "stages": "./index.ts",
  "requires": {
    "contract/skills": "^1"
  },
  "provides": {
    "stage/retrieve": "1.0.0"
  },
  "envelope": {
    "requires": [],
    "provides": [],
    "spawn": {
      "scope": "person",
      "network": "none"
    }
  },
  "settings": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fusionWeight": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.7
      },
      "absorb": {
        "type": "boolean",
        "default": true
      }
    },
    "additionalProperties": false
  }
}
