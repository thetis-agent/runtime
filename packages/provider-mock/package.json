{
  "name": "provider-mock",
  "version": "1.0.0",
  "type": "module",
  "stages": "./index.ts",
  "settings": {
    "type": "object",
    "properties": {
      "requestBytes": {
        "type": "integer",
        "minimum": 1,
        "default": 4194304
      },
      "cacheEntries": {
        "type": "integer",
        "minimum": 1,
        "default": 256
      },
      "scriptEvents": {
        "type": "integer",
        "minimum": 1,
        "default": 4096
      },
      "maximumCost": {
        "type": "number",
        "minimum": 0,
        "default": 0.01
      }
    },
    "additionalProperties": false
  },
  "requires": {
    "contract/provider": "^1.1"
  },
  "provides": {
    "service/llm-provider.mock": "1.0.0"
  },
  "envelope": {
    "requires": [],
    "provides": [],
    "spawn": {
      "scope": "deployment",
      "network": "none"
    }
  }
}
