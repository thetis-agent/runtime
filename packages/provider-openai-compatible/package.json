{
  "name": "provider-openai-compatible",
  "version": "1.0.0",
  "type": "module",
  "stages": "./index.ts",
  "settings": {
    "type": "object",
    "properties": {
      "endpoint": { "type": "string", "default": "https://openrouter.ai/api/v1/chat/completions" },
      "models": { "type": "array", "maxItems": 256, "items": { "$ref": "thetis://contract/provider/1#/$defs/modelCap" } },
      "deadlineMs": { "type": "integer", "minimum": 1, "default": 120000 },
      "eventBytes": { "type": "integer", "minimum": 1, "default": 1048576 },
      "cacheMarkers": { "type": "integer", "minimum": 1, "maximum": 4, "default": 4 }
    },
    "additionalProperties": false
  },
  "requires": { "contract/provider": "^1.1", "secret/llm-key": "*" },
  "provides": { "service/llm-provider.openai-compatible": "1.0.0" },
  "envelope": { "requires": [], "provides": [], "spawn": { "scope": "deployment", "network": "outbound" } }
}
